# ─────────────────────────────────────────────────────────────────────────────
# Hometown Hub — server environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env` file.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
# Hosting platforms inject PORT. SERVER_PORT takes precedence when set, so a PORT
# exported for another process in the same shell cannot steal the API's port.
SERVER_PORT=5000
# PORT=5000

# Comma-separated list of origins allowed to call this API (the web client).
CLIENT_ORIGINS=http://localhost:5173

# MongoDB (Mongoose). A local MongoDB server listens on 27017 by default.
MONGODB_URI=mongodb://127.0.0.1:27017/hometown_hub
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/hometown_hub_test

# Auth — generate long random values, e.g. `openssl rand -hex 48`
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# Password reset links point at the web client
CLIENT_URL=http://localhost:5173

# Local disk uploads (development only — use S3/Cloudinary in production)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# First account created with this email is granted the platform_admin role.
PLATFORM_ADMIN_EMAIL=admin@hometownhub.test
