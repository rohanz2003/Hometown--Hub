# Hometown Hub — client environment template
# Copy to `.env` (or `.env.local`) if you need to override the defaults.

# Base URL for the REST API. Leave blank in development: Vite proxies /api to the
# Express server, which keeps the httpOnly refresh cookie same-origin.
# In production set this to your deployed API origin, e.g. https://api.example.com
VITE_API_BASE_URL=
